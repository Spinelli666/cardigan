{{!-- 
Template para itens do tipo arma com sistema de propriedades dinâmicas
--}}
<section class="tab item-type-arma {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="weapon-details-form">

    {{!-- Top grid: weapon properties (left) and skill bonuses (right) --}}
    <div class="weapon-top-grid">
      <div class="weapon-properties">
        <div class="weapon-properties-content">
          <div class="weapon-category-toggles">
            <button type="button" class="weapon-category-btn" data-weapon-category="melee" data-tooltip="{{localize 'CARDIGAN.WeaponMelee'}}" data-tooltip-class='cardigan-tooltip' {{#if item.system.melee}}data-selected{{/if}}>
              <img src="systems/cardigan/assets/images/weapons/sword.webp" alt="{{localize 'CARDIGAN.WeaponMelee'}}" title="{{localize 'CARDIGAN.WeaponMelee'}}"/>
            </button>
            <button type="button" class="weapon-category-btn" data-weapon-category="ranged" data-tooltip="{{localize 'CARDIGAN.WeaponRanged'}}" data-tooltip-class='cardigan-tooltip' {{#if item.system.ranged}}data-selected{{/if}}>
              <img src="systems/cardigan/assets/images/weapons/arrow.webp" alt="{{localize 'CARDIGAN.WeaponRanged'}}" title="{{localize 'CARDIGAN.WeaponRanged'}}"/>
            </button>
            {{#if item.system.ranged}}
              <button type="button" class="weapon-category-btn" data-weapon-category="isFirearm" data-tooltip="{{localize 'CARDIGAN.IsFirearm'}}" data-tooltip-class='cardigan-tooltip' {{#if item.system.isFirearm}}data-selected{{/if}}>
                <img src="systems/cardigan/assets/images/weapons/pistol.webp" alt="{{localize 'CARDIGAN.IsFirearm'}}" title="{{localize 'CARDIGAN.IsFirearm'}}"/>
              </button>
            {{/if}}
          </div>
        </div>

        <div class="armor-extra-properties">
          <div class="weapon-extra-property weapon-protection-property">
            <div class="weapon-extra-content">
              <img class="weapon-extra-icon" src="systems/cardigan/assets/images/decorative/icons/icon-armor.svg" alt="{{localize 'CARDIGAN.ArmorProtection'}}" data-tooltip="Proteção" data-tooltip-class='cardigan-tooltip' />
              <div class="weapon-protection-input-wrapper weapon-extra-panel" data-weapon-extra-panel="protection">
                <input type="number" name="system.protection.value" value="{{item.system.protection.value}}" min="0" placeholder="0"/>
              </div>
            </div>
          </div>

          <div class="armor-extra-property armor-durability-property">
            <div class="armor-extra-content">
              <img class="armor-extra-icon" src="systems/cardigan/assets/images/decorative/icons/icon-durability.svg" alt="{{localize 'CARDIGAN.Durability'}}" data-tooltip="Durabilidade" data-tooltip-class='cardigan-tooltip' />
              <div class="durability-container durability-container--expanded armor-extra-panel" data-armor-extra-panel="durability">
                <input class="durability-value-input" type="number" name="system.durability.current" value="{{item.system.durability.current}}" min="0" max="{{item.system.durability.max}}"/>
                <img src="systems/cardigan/assets/images/decorative/field-divider.svg" alt="/" class="durability-divider"/>
                <input class="durability-value-input" type="number" name="system.durability.max" value="{{item.system.durability.max}}" min="1"/>
              </div>
            </div>
          </div>
        </div>

        <div class="armor-extra-properties weapon-damage-price-properties">
          <div class="weapon-extra-property weapon-price-property">
            <div class="weapon-extra-content">
              <img class="weapon-extra-icon" src="systems/cardigan/assets/images/decorative/icons/icon-coins.svg" alt="{{localize 'CARDIGAN.Price'}}" data-tooltip="Preço" data-tooltip-class='cardigan-tooltip' />
              <div class="weapon-price-input-wrapper weapon-extra-panel" data-weapon-extra-panel="price">
                <input type="number" name="system.price" value="{{item.system.price}}" min="0" placeholder="0"/>
              </div>
            </div>
          </div>

          <div class="weapon-extra-property weapon-damage-property">
            <div class="weapon-extra-content">
              <img class="weapon-extra-icon" src="systems/cardigan/assets/images/decorative/accuracy-attack.webp" alt="{{localize 'CARDIGAN.Damage'}}" data-tooltip="Dano Total" data-tooltip-class='cardigan-tooltip' />
              <div class="weapon-damage-input-wrapper weapon-extra-panel" data-weapon-extra-panel="damage">
                <input type="text" name="system.damage.value" value="{{item.system.damage.value}}" placeholder="0"/>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="weapon-skill-bonuses">
        <table class="weapon-skill-bonuses-table">
          <tbody>
            {{#each weaponSkillBonusRows as |row|}}
              <tr class="weapon-skill-bonus-row">
                <th scope="row">{{row.label}}</th>
                <td>
                  <input type="hidden" name="system.skillBonuses.{{row.index}}.skill" value="{{row.key}}" />
                  <div class="weapon-skill-bonus-input-wrapper">
                    <input
                      type="number"
                      name="system.skillBonuses.{{row.index}}.bonus"
                      value="{{row.value}}"
                      data-dtype="Number"
                      placeholder="0"
                    />
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    {{!-- Basic Information --}}
    <fieldset class="weapon-section">
      <legend>{{localize "CARDIGAN.WeaponBasicInfo"}}</legend>

      <div class="form-group magazine-section" style="{{#unless item.system.isFirearm}}display: none;{{/unless}}">
        <label for="system.magazine">Weapon Magazine</label>
        <input type="number" name="system.magazine" value="{{item.system.magazine}}" min="0" style="width: 80px;" placeholder="0"/>
      </div>

      <div class="form-group">
        <label for="system.weight">{{localize "CARDIGAN.Weight"}}</label>
        <select name="system.weight">
          <option value="light" {{selected item.system.weight "light"}}>{{localize "CARDIGAN.WeightLight"}}</option>
          <option value="heavy" {{selected item.system.weight "heavy"}}>{{localize "CARDIGAN.WeightHeavy"}}</option>
        </select>
      </div>
    </fieldset>

    {{!-- Combat Stats --}}
    <fieldset class="weapon-section">
      <legend>{{localize "CARDIGAN.CombatStats"}}</legend>
      
      <div class="form-group damage-total-section">
        <div class="ability-selection" style="display: flex; gap: 15px; margin-bottom: 5px;">
          <label style="display: flex; align-items: center; gap: 5px;">
            <input type="checkbox" name="system.damage.useStrength" {{checked item.system.damage.useStrength}} data-mutually-exclusive="damage-ability"/>
            {{localize "CARDIGAN.Ability.Strength.abbr"}}
          </label>
          <label style="display: flex; align-items: center; gap: 5px;">
            <input type="checkbox" name="system.damage.useDexterity" {{checked item.system.damage.useDexterity}} data-mutually-exclusive="damage-ability"/>
            {{localize "CARDIGAN.Ability.Dexterity.abbr"}}
          </label>
          <label style="display: flex; align-items: center; gap: 5px;">
            <input type="checkbox" name="system.damage.usePsionics" {{checked item.system.damage.usePsionics}} data-mutually-exclusive="damage-ability"/>
            {{localize "CARDIGAN.Ability.Psionics.abbr"}}
          </label>
        </div>
        <div class="form-group">
          <label for="system.damage.total">{{localize "CARDIGAN.DamageTotal"}}</label>
          <input type="text" name="system.damage.total" value="{{item.system.damage.total}}" readonly/>
        </div>
      </div>
    </fieldset>

    {{!-- Weapon Properties --}}
    <fieldset class="weapon-section">
      <legend>{{localize "CARDIGAN.WeaponProperties"}}</legend>
      
      <div class="form-group weapon-properties">
        <div class="properties-header">
          <button type="button" class="add-property-btn" data-action="addWeaponProperty" title="{{localize 'CARDIGAN.AddProperty'}}">+</button>
        </div>
        
        <div class="properties-list" data-properties-container>
          {{#if item.system.properties.length}}
            {{#each item.system.properties as |property index|}}
              <div class="property-row" data-property-index="{{index}}">
                <select name="system.properties.{{index}}" data-property-select>
                  <option value="">{{localize "CARDIGAN.SelectProperty"}}</option>
                  <option value="bomba" {{selected property "bomba"}}>{{localize "CARDIGAN.WeaponProperty.Bomba"}}</option>
                  <option value="accurate" {{selected property "accurate"}}>{{localize "CARDIGAN.WeaponProperty.Accurate"}}</option>
                  <option value="colateral" {{selected property "colateral"}}>{{localize "CARDIGAN.WeaponProperty.Colateral"}}</option>
                  <option value="blunt" {{selected property "blunt"}}>{{localize "CARDIGAN.WeaponProperty.Blunt"}}</option>
                  <option value="discreto" {{selected property "discreto"}}>{{localize "CARDIGAN.WeaponProperty.Discreto"}}</option>
                  <option value="duelar" {{selected property "duelar"}}>{{localize "CARDIGAN.WeaponProperty.Duelar"}}</option>
                  <option value="electrify" {{selected property "electrify"}}>{{localize "CARDIGAN.WeaponProperty.Electrify"}}</option>
                  <option value="extensao" {{selected property "extensao"}}>{{localize "CARDIGAN.WeaponProperty.Extensao"}}</option>
                  <option value="wound" {{selected property "wound"}}>{{localize "CARDIGAN.WeaponProperty.Wound"}}</option>
                  <option value="impact" {{selected property "impact"}}>{{localize "CARDIGAN.WeaponProperty.Impact"}}</option>
                  <option value="ignite" {{selected property "ignite"}}>{{localize "CARDIGAN.WeaponProperty.Ignite"}}</option>
                  <option value="pente" {{selected property "pente"}}>{{localize "CARDIGAN.WeaponProperty.Pente"}}</option>
                  <option value="perfurar" {{selected property "perfurar"}}>{{localize "CARDIGAN.WeaponProperty.Perfurar"}}</option>
                  <option value="queimaroupa" {{selected property "queimaroupa"}}>{{localize "CARDIGAN.WeaponProperty.QueimaRoupa"}}</option>
                  <option value="rajada" {{selected property "rajada"}}>{{localize "CARDIGAN.WeaponProperty.Rajada"}}</option>
                  <option value="recarga" {{selected property "recarga"}}>{{localize "CARDIGAN.WeaponProperty.Recarga"}}</option>
                  <option value="saquerapido" {{selected property "saquerapido"}}>{{localize "CARDIGAN.WeaponProperty.SaqueRapido"}}</option>
                  <option value="pierce" {{selected property "pierce"}}>{{localize "CARDIGAN.WeaponProperty.Pierce"}}</option>
                  <option value="unico" {{selected property "unico"}}>{{localize "CARDIGAN.WeaponProperty.Unico"}}</option>
                  <option value="vorpal" {{selected property "vorpal"}}>{{localize "CARDIGAN.WeaponProperty.Vorpal"}}</option>
                </select>
                <button type="button" class="remove-property-btn" data-action="removeWeaponProperty" data-index="{{index}}" title="{{localize 'CARDIGAN.RemoveProperty'}}">−</button>
              </div>
            {{/each}}
          {{else}}
            <div class="property-row" data-property-index="0">
              <select name="system.properties.0" data-property-select>
                <option value="">{{localize "CARDIGAN.SelectProperty"}}</option>
                <option value="bomba">{{localize "CARDIGAN.WeaponProperty.Bomba"}}</option>
                <option value="accurate">{{localize "CARDIGAN.WeaponProperty.Accurate"}}</option>
                <option value="blunt">{{localize "CARDIGAN.WeaponProperty.Blunt"}}</option>
                <option value="bomba">{{localize "CARDIGAN.WeaponProperty.Bomba"}}</option>
                <option value="colateral">{{localize "CARDIGAN.WeaponProperty.Colateral"}}</option>
                <option value="discreto">{{localize "CARDIGAN.WeaponProperty.Discreto"}}</option>
                <option value="duelar">{{localize "CARDIGAN.WeaponProperty.Duelar"}}</option>
                <option value="electrify">{{localize "CARDIGAN.WeaponProperty.Electrify"}}</option>
                <option value="extensao">{{localize "CARDIGAN.WeaponProperty.Extensao"}}</option>
                <option value="ignite">{{localize "CARDIGAN.WeaponProperty.Ignite"}}</option>
                <option value="impact">{{localize "CARDIGAN.WeaponProperty.Impact"}}</option>
                <option value="pente">{{localize "CARDIGAN.WeaponProperty.Pente"}}</option>
                <option value="perfurar">{{localize "CARDIGAN.WeaponProperty.Perfurar"}}</option>
                <option value="pierce">{{localize "CARDIGAN.WeaponProperty.Pierce"}}</option>
                <option value="queimaroupa">{{localize "CARDIGAN.WeaponProperty.QueimaRoupa"}}</option>
                <option value="rajada">{{localize "CARDIGAN.WeaponProperty.Rajada"}}</option>
                <option value="recarga">{{localize "CARDIGAN.WeaponProperty.Recarga"}}</option>
                <option value="saquerapido">{{localize "CARDIGAN.WeaponProperty.SaqueRapido"}}</option>
                <option value="unico">{{localize "CARDIGAN.WeaponProperty.Unico"}}</option>
                <option value="vorpal">{{localize "CARDIGAN.WeaponProperty.Vorpal"}}</option>
                <option value="wound">{{localize "CARDIGAN.WeaponProperty.Wound"}}</option>
              </select>
              <button type="button" class="remove-property-btn" data-action="removeWeaponProperty" data-index="0" title="{{localize 'CARDIGAN.RemoveProperty'}}">−</button>
            </div>
          {{/if}}
        </div>
      </div>
    </fieldset>

    {{!-- Special Properties --}}
    <fieldset class="weapon-section">
      <legend>{{localize "CARDIGAN.SpecialProperties"}}</legend>
      
      <div class="form-group">
        <label for="system.magicalArtifact">{{localize "CARDIGAN.MagicalArtifact"}}</label>
        <input type="checkbox" name="system.magicalArtifact" {{checked item.system.magicalArtifact}}/>
      </div>
    </fieldset>

    {{!-- Hidden fields - not visible to players --}}
    <input type="hidden" name="system.quantity" value="{{item.system.quantity}}" data-dtype="Number"/>
    <input type="hidden" name="system.rightHand" {{checked item.system.rightHand}}/>
    <input type="hidden" name="system.leftHand" {{checked item.system.leftHand}}/>

  </div>
</section>

{{!-- Consumable Item Summary — rendered inside the backpack's expandable description row --}}
<div class="consumable-item-summary">
  <div class="consumable-summary-body">
    {{#if enrichedDescription}}
    <div class="consumable-summary-description">
      {{{enrichedDescription}}}
    </div>
    <img class="consumable-summary-description-border" src="systems/cardigan/assets/images/decorative/border.webp" alt="Borda decorativa" />
    {{/if}}

    <div class="consumable-summary-header">
      <div class="consumable-summary-header-left">
        {{#if system.hasLifeEnergySection}}
        <div class="consumable-summary-header-badge" data-tooltip-html="{{lifeEnergyTooltipHtml}}" data-tooltip-class="cardigan-tooltip consumable-badge-tooltip" data-tooltip-direction="DOWN">
          <span class="consumable-summary-header-badge-text">VIDA &amp; ENERGIA</span>
        </div>
        {{/if}}
        {{#if system.hasEffectsSection}}
        <div class="consumable-summary-header-badge" data-tooltip-html="{{effectsTooltipHtml}}" data-tooltip-class="cardigan-tooltip consumable-badge-tooltip" data-tooltip-direction="DOWN">
          <span class="consumable-summary-header-badge-text">EFEITOS</span>
        </div>
        {{/if}}
        {{#if system.hasSkillCheck}}
        <div class="consumable-summary-header-badge" data-tooltip-html="{{skillTestTooltipHtml}}" data-tooltip-class="cardigan-tooltip consumable-badge-tooltip" data-tooltip-direction="DOWN">
          <span class="consumable-summary-header-badge-text">TESTE DE PERÍCIA</span>
        </div>
        {{/if}}
      </div>

      <div class="consumable-summary-header-right">
        <img class="consumable-summary-profession-icon{{#if (eq system.profession "alchemy")}}{{else if (eq system.profession "blacksmithing")}}{{else if (eq system.profession "culinary")}}{{else if (eq system.profession "tailoring")}}{{else if (eq system.profession "tecnomagic")}}{{else}} consumable-summary-profession-icon--general{{/if}}"
          src="systems/cardigan/assets/images/profession/{{#if (eq system.profession "alchemy")}}icon-alchemy.svg{{else if (eq system.profession "blacksmithing")}}icon-blacksmithing.svg{{else if (eq system.profession "culinary")}}icon-culinary.svg{{else if (eq system.profession "tailoring")}}icon-tailoring.svg{{else if (eq system.profession "tecnomagic")}}icon-technomagic.svg{{else}}icon-profession.webp{{/if}}"
          alt="{{localize (concat 'CARDIGAN.ItemIngredient.Professions.' (capitalize system.profession))}}"
          data-tooltip="{{localize (concat 'CARDIGAN.ItemIngredient.Professions.' (capitalize system.profession))}}"
          data-tooltip-class='cardigan-tooltip' />

        <span class="consumable-summary-divider">⬩</span>

        <div class="consumable-summary-price">
          <img class="consumable-summary-price-icon" src="systems/cardigan/assets/images/decorative/icons/icon-coins.svg" alt="{{localize 'CARDIGAN.Price'}}" data-tooltip="Preço" data-tooltip-class='cardigan-tooltip' />
          <span class="consumable-summary-price-text">{{system.price}}</span>
        </div>

        <span class="consumable-summary-divider">⬩</span>

        <div class="consumable-summary-weight">
          <img class="consumable-summary-weight-icon" src="systems/cardigan/assets/images/decorative/icons/icon-weight.svg" alt="{{localize 'CARDIGAN.Weight'}}" data-tooltip="Peso" data-tooltip-class='cardigan-tooltip' />
          <span class="consumable-summary-weight-text">
            {{#if (eq system.weight "light")}}{{localize "CARDIGAN.WeightLight"}}
            {{else if (eq system.weight "medium")}}{{localize "CARDIGAN.WeightMedium"}}
            {{else if (eq system.weight "heavy")}}{{localize "CARDIGAN.WeightHeavy"}}
            {{else if (eq system.weight "very-heavy")}}{{localize "CARDIGAN.WeightVeryHeavy"}}
            {{/if}}
          </span>
        </div>
      </div>
    </div>

    {{#if hasAnyInfo}}
    <div class="consumable-summary-info">
      <div class="consumable-summary-properties">
        {{#each propertyRows as |row|}}
        <div class="consumable-summary-properties-row">
          {{#each row as |entry|}}
          {{#if (eq entry.kind "armor")}}
          <div class="consumable-summary-property-box">
            <div class="consumable-summary-property-item">
              <img class="consumable-summary-armor-icon" src="systems/cardigan/assets/images/decorative/icons/icon-armor.svg" alt="{{localize 'CARDIGAN.Armor'}}" data-tooltip="Bônus de Armadura" data-tooltip-class='cardigan-tooltip' />
              <div class="consumable-summary-armor-value">
                <span class="consumable-summary-armor-text">{{entry.displayValue}}</span>
              </div>
            </div>
          </div>
          {{else if (eq entry.kind "movement")}}
          <div class="consumable-summary-property-box">
            <div class="consumable-summary-property-item">
              <img class="consumable-summary-movement-icon" src="systems/cardigan/assets/images/decorative/icons/icon-movement.svg" alt="{{localize 'CARDIGAN.MovementBonus'}}" data-tooltip="Bônus de Movimento" data-tooltip-class='cardigan-tooltip' />
              <div class="consumable-summary-movement-value">
                <span class="consumable-summary-movement-text">{{entry.displayValue}}</span>
              </div>
            </div>
          </div>
          {{else if (eq entry.kind "critical")}}
          <div class="consumable-summary-property-box">
            <div class="consumable-summary-property-item">
              <img class="consumable-summary-critical-icon" src="systems/cardigan/assets/images/decorative/icons/icon-critical.svg" alt="{{localize 'CARDIGAN.ItemConsumivel.CriticalHitBoostAmount'}}" data-tooltip="Bônus de Crítico" data-tooltip-class='cardigan-tooltip' />
              <div class="consumable-summary-critical-value">
                <span class="consumable-summary-critical-text">{{entry.displayValue}}</span>
              </div>
            </div>
          </div>
          {{else if (eq entry.kind "skill")}}
          <div class="consumable-summary-property-box">
            <div class="consumable-summary-property-item consumable-summary-property-item--skill">
              <span class="consumable-summary-skill-bonus-value">{{entry.displayValue}}</span>
              <span class="consumable-summary-skill-bonus-label">{{entry.abbr}}</span>
            </div>
          </div>
          {{else if (eq entry.kind "status")}}
          <div class="consumable-summary-property-box">
            <div class="consumable-summary-property-item">
              <img class="consumable-summary-status-icon" src="systems/cardigan/assets/images/decorative/icons/{{entry.icon}}" alt="{{entry.label}}" data-tooltip="{{entry.label}}" data-tooltip-class='cardigan-tooltip' />
              <div class="consumable-summary-status-value">
                <span class="consumable-summary-status-text">{{entry.displayValue}}</span>
              </div>
            </div>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{#if enrichedSystematicDescription}}
    <img class="consumable-summary-info-border" src="systems/cardigan/assets/images/decorative/border-description.png" alt="Borda decorativa" />
    <div class="consumable-summary-systematic-description">
      {{{enrichedSystematicDescription}}}
    </div>
    {{/if}}
  </div>
</div>

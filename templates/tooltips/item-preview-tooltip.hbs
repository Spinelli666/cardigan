{{!-- Item preview tooltip (mochila) — hover no ícone de um item-consumivel. Renderizado via
      ConsumablePreviewTooltip._buildTooltipHtml e injetado em data-tooltip-html. --}}
<div class='item-preview-tooltip-inner'>
  {{#unless hideDividers}}
  <img src='systems/cardigan/assets/images/decorative/divider.webp' alt='divider' class='divider-left' />
  <img src='systems/cardigan/assets/images/decorative/divider.webp' alt='divider' class='divider-right' />
  {{/unless}}
  <div class='tooltip-icon'>
    <img src='{{item.img}}' alt='{{item.name}}' />
  </div>
  <div class='tooltip-header'>
    <h2 class='tooltip-title'>{{item.name}}</h2>
  </div>
  <div class='item-preview-tooltip-body'>
    {{#if hasDescription}}
    <div class='item-preview-tooltip-description'>{{{description}}}</div>
    {{/if}}
    <img class='consumable-summary-description-border' src='systems/cardigan/assets/images/decorative/border.webp' alt='Borda decorativa' />
    {{#if hasInfoRows}}
    <div class='item-preview-tooltip-info'>
      {{#each infoRowGroups as |group|}}
      <div class='item-preview-tooltip-info-row'>
        {{#each group as |row|}}
        <div class='item-preview-tooltip-info-box'>
          <div class='item-preview-tooltip-info-item item-preview-tooltip-info-item--{{row.kind}}'>
            {{#if row.icon}}
            <img class='item-preview-tooltip-info-icon' src='systems/cardigan/assets/images/decorative/icons/{{row.icon}}' alt='{{row.label}}' />
            {{/if}}
            <div class='item-preview-tooltip-info-value'>
              <span class='item-preview-tooltip-info-text'>{{row.displayValue}}</span>
              {{#if row.abbr}}<span class='item-preview-tooltip-info-abbr'>{{row.abbr}}</span>{{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    <img class='consumable-summary-info-border' src='systems/cardigan/assets/images/decorative/border-description.png' alt='Borda decorativa' />
    {{#if hasSystematicDescription}}
    <div class='consumable-summary-systematic-description'>{{{enrichedSystematicDescription}}}</div>
    {{/if}}
    {{/if}}
  </div>
  {{#unless hideFooter}}
  <div class='item-preview-tooltip-footer'>
    <div class='item-preview-tooltip-footer-icon'></div>
    <span class='item-preview-tooltip-footer-text'>{{localize 'CARDIGAN.Tooltip.MiddleClickToLock'}}</span>
  </div>
  {{/unless}}
</div>

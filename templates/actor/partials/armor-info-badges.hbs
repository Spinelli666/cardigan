{{!-- armor-info-badges.hbs: badges de informação para armaduras.
      Lista já priorizada e limitada a 3 itens por armorInfoBadges() (armor-info-badges.mjs) —
      quando há mais características do que cabem, só as mais importantes aparecem aqui. --}}
{{!-- Parâmetro: item --}}
{{#each (armorInfoBadges item) as |badge|}}
  <div class='{{badge.kind}} info-badge'>
    {{#if badge.icon}}
    <img
      src='systems/cardigan/assets/images/decorative/icons/{{badge.icon}}'
      alt='{{localize badge.labelKey}}'
      class='information-icon'
      width='20'
      height='20'
    />
    {{/if}}
    {{#unless badge.iconOnly}}
    <div class='bonus-display'>
      <span class='bonus-value'>
        {{badge.displayValue}}
        {{#if badge.abbr}} {{badge.abbr}}{{/if}}
      </span>
    </div>
    {{/unless}}
  </div>
{{/each}}
